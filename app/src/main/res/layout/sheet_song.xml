<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="26dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_handle" />

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <TextView
                android:id="@+id/song_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="40sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/song_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo_plate"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/fg"
            android:textIsSelectable="true"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/soft_fg"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/song_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/song_spotify"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_accent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="Sök i Spotify"
            android:textColor="@color/on_accent"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/song_recent_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="TIDIGARE"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/song_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
